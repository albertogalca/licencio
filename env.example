# Copy to .env and fill in:  cp env.example .env
# .env is gitignored; never commit real secrets.
# docker compose reads .env (env_file: .env) and passes it to the web container.

# ── Required ──────────────────────────────────────────────────────────────────

# Unlocks Rails credentials + Active Record encryption (encrypted Product columns).
# From your master key:  echo "RAILS_MASTER_KEY=$(cat config/master.key)" >> .env
RAILS_MASTER_KEY=

# Public host for magic-link / mailer URLs (no scheme), e.g. licenses.yourapp.com
APP_HOST=localhost

# ── Database ──────────────────────────────────────────────────────────────────
# Single Postgres database (Solid Queue/Cache/Cable live here too).
# docker compose builds DATABASE_URL for you from the vars below — only set
# DATABASE_URL directly when pointing at an external/managed Postgres.
POSTGRES_USER=licencio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=licencio_production
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── Stripe (selling licenses) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...              # signing secret for POST /webhooks/stripe
CHECKOUT_SUCCESS_URL=https://yourapp.com/thanks
CHECKOUT_CANCEL_URL=https://yourapp.com/pricing

# ── Email (Loops, optional) ───────────────────────────────────────────────────
# Fallback Loops API key. A per-Product loops_api_key overrides this.
LOOPS_API_KEY_DEFAULT=

# ── Admin API (bulk license import) ───────────────────────────────────────────
# Bearer token for POST /api/admin/*. Generate: openssl rand -hex 32
ADMIN_API_KEY=

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# WEB_CONCURRENCY=2        # Puma workers per container
# JOB_CONCURRENCY=1        # Solid Queue worker processes
# RAILS_LOG_LEVEL=info
# WEB_PORT=80              # host port docker compose binds
