<% content_for :title, "#{@affiliate.code} — Licencio" %>

<div class="mb-8">
  <%= link_to "← Affiliates", admin_affiliates_path, class: "link-muted text-sm" %>
  <div class="mt-2 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <h1 class="font-mono text-xl font-semibold tracking-tight"><%= @affiliate.code %></h1>
      <%= status_badge(@affiliate.status) %>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_admin_affiliate_path(@affiliate), class: "btn-ghost" %>
      <% unless @affiliate.approved? %>
        <%= button_to "Approve", admin_affiliate_approval_path(@affiliate), method: :post, class: "btn-primary" %>
      <% end %>
    </div>
  </div>
  <p class="mt-2 text-sm text-gray-500">
    <%= @affiliate.name %> · <%= @affiliate.email %>
    <% if @affiliate.payout_email.present? %> · pays out to <%= @affiliate.payout_email %><% end %>
  </p>
  <p class="mt-1 text-sm text-gray-500">
    <%= safe_join(@products.map { |product|
          tag.span(safe_join([ product.name, " ",
            tag.span(@affiliate.commission_percent_for(product), class: "tabular-nums"), "%" ]))
        }, " · ") %>
  </p>
</div>

<div class="mb-8 grid grid-cols-3 gap-3">
  <% [
       ["Payable (cleared hold)", money_cents(@payable_cents)],
       ["Paid out", money_cents(@paid_cents)],
       ["Owed now", money_cents(@owed_cents)],
     ].each do |label, value| %>
    <div class="card p-4">
      <p class="text-xs text-gray-500"><%= label %></p>
      <p class="mt-1 text-lg font-semibold tabular-nums"><%= value %></p>
    </div>
  <% end %>
</div>

<div class="card mb-8 p-5">
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Record a payout</h2>
  <%= form_with scope: :payout, url: admin_affiliate_payouts_path(@affiliate), method: :post, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :amount_cents, "Amount (cents)", class: "field-label" %>
      <%= form.number_field :amount_cents, required: true, min: 1, class: "field-input w-40" %>
    </div>
    <div>
      <%= form.label :currency, "Currency", class: "field-label" %>
      <%= form.text_field :currency, value: "EUR", required: true, class: "field-input w-24" %>
    </div>
    <div class="flex-1">
      <%= form.label :note, "Note", class: "field-label" %>
      <%= form.text_field :note, placeholder: "wise txn 1234", class: "field-input" %>
    </div>
    <%= form.submit "Mark paid", class: "btn-primary" %>
  <% end %>
</div>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Referred sales</h2>
<% if @payments.any? %>
  <div class="table-card mb-8">
    <table class="data-table">
      <thead>
        <tr><th>Date</th><th>Product</th><th>Sale</th><th>Commission</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% @payments.each do |payment| %>
          <tr>
            <td><%= payment.created_at.to_date %></td>
            <td><%= payment.license.product.name %></td>
            <td class="tabular-nums"><%= money_cents(payment.amount_cents, payment.currency) %></td>
            <td class="tabular-nums"><%= money_cents(payment.commission_cents) %></td>
            <td><%= status_badge(payment.license.status) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="mb-8 rounded-lg border border-dashed border-gray-200 bg-white px-4 py-8 text-center text-sm text-gray-500">No referred sales yet.</p>
<% end %>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Payouts</h2>
<% if @payouts.any? %>
  <div class="table-card">
    <table class="data-table">
      <thead><tr><th>Paid</th><th>Amount</th><th>Note</th></tr></thead>
      <tbody>
        <% @payouts.each do |payout| %>
          <tr>
            <td><%= payout.paid_at.to_date %></td>
            <td class="tabular-nums"><%= money_cents(payout.amount_cents, payout.currency) %></td>
            <td class="text-gray-500"><%= payout.note %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-lg border border-dashed border-gray-200 bg-white px-4 py-8 text-center text-sm text-gray-500">No payouts recorded.</p>
<% end %>
