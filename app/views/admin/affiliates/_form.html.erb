<%= form_with model: [ :admin, affiliate ], class: "space-y-4" do |form| %>
  <% if affiliate.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <%= affiliate.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, class: "field-input" %>
  </div>
  <div>
    <%= form.label :email, class: "field-label" %>
    <%= form.email_field :email, class: "field-input" %>
  </div>
  <div>
    <%= form.label :code, "Referral code", class: "field-label" %>
    <%= form.text_field :code, class: "field-input font-mono" %>
  </div>
  <div>
    <%= form.label :payout_email, "Payout email", class: "field-label" %>
    <%= form.email_field :payout_email, class: "field-input" %>
  </div>
  <div>
    <%= form.label :commission_percent, "Default commission %", class: "field-label" %>
    <%= form.number_field :commission_percent, in: 0..100, class: "field-input w-32" %>
    <p class="mt-1 text-xs text-gray-500">Used only for products with no rate of their own.</p>
  </div>
  <div>
    <%= form.label :status, class: "field-label" %>
    <%= form.select :status, Affiliate.statuses.keys.map { |s| [s.capitalize, s] }, {}, class: "field-select w-auto" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", admin_affiliate_path(affiliate), class: "link-muted" %>
  </div>
<% end %>
