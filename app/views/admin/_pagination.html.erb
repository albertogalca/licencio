<% if @total_pages && @total_pages > 1 %>
  <nav class="mt-5 flex items-center justify-between text-body text-gray-500">
    <span>
      <span class="tabular-nums font-medium text-gray-700"><%= @total_count %></span> total ·
      page <span class="tabular-nums"><%= @page %></span> of <span class="tabular-nums"><%= @total_pages %></span>
    </span>
    <span class="flex gap-2">
      <% [ [ "← Prev", @page - 1, @page > 1 ], [ "Next →", @page + 1, @page < @total_pages ] ].each do |label, target, enabled| %>
        <% if enabled %>
          <%= link_to label, "#{request.path}?#{request.query_parameters.merge(page: target).to_query}", class: "btn-ghost" %>
        <% else %>
          <span class="btn-ghost pointer-events-none opacity-50" aria-disabled="true"><%= label %></span>
        <% end %>
      <% end %>
    </span>
  </nav>
<% end %>
