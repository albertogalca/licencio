<% content_for :title, "Devices — Licencio" %>

<h1 class="mb-8 text-title font-bold tracking-tight">Devices</h1>

<% if @activations.any? %>
  <div class="card overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>Device</th>
          <th>Product</th>
          <th>Customer</th>
          <th>Activated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @activations.each do |a| %>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                <%= activation_dot(a) %>
                <span class="truncate"><%= a.device_name.presence || a.hardware_id %></span>
              </div>
            </td>
            <td class="text-gray-600"><%= a.license.product.name %></td>
            <td class="text-gray-600"><%= a.license.customer&.email %></td>
            <td class="text-gray-600 tabular-nums"><%= a.activated_at&.to_date %></td>
            <td class="text-right">
              <% if a.deactivated_at %>
                <span class="text-meta text-gray-600">deactivated</span>
              <% else %>
                <%= button_to "Deactivate", admin_activation_path(a), method: :delete,
                  form: { data: { turbo_confirm: "Deactivate this device? It frees a seat; the customer can reactivate." } },
                  class: "link-danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "admin/pagination" %>
<% else %>
  <p class="empty-state">No devices yet. One appears here the first time a device uses a license key.</p>
<% end %>
