<% content_for :title, "Overview — Licencio" %>

<h1 class="mb-6 text-xl font-semibold tracking-tight">Overview</h1>

<% stats = [
     { label: "Active licenses", value: @active_licenses },
     { label: "New licenses",    value: @new_licenses,  sub: "last 30 days" },
     { label: "Refunded",        value: @refunded,      sub: "last 30 days" },
     { label: "Customers",       value: @customers },
     { label: "Active devices",  value: @active_devices },
   ] %>

<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
  <% stats.each do |stat| %>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500"><%= stat[:label] %></p>
      <p class="mt-2 text-3xl font-semibold tabular-nums tracking-tight"><%= number_with_delimiter(stat[:value]) %></p>
      <p class="mt-1 text-xs text-gray-600"><%= stat[:sub] || " " %></p>
    </div>
  <% end %>
</div>

<h2 class="mb-3 mt-10 text-xs font-semibold uppercase tracking-wide text-gray-500">By product</h2>
<div class="table-card">
  <table class="data-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Licenses</th>
        <th>Active</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |row| %>
        <tr>
          <td class="font-medium"><%= row[:product].name %></td>
          <td class="text-gray-600 tabular-nums"><%= number_with_delimiter(row[:licenses]) %></td>
          <td class="text-gray-600 tabular-nums"><%= number_with_delimiter(row[:active]) %></td>
          <td class="text-right">
            <%= link_to "View", admin_licenses_path(product_id: row[:product].id), class: "link-accent" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
