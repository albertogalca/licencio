<% content_for :title, "Customers — Licencio" %>

<h1 class="mb-6 text-xl font-semibold">Customers</h1>

<%= form_with url: admin_customers_path, method: :get, class: "mb-4 flex flex-wrap gap-3 text-sm" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Search email, name…",
    class: "min-w-64 flex-1 rounded-md border border-gray-300 px-3 py-2" %>
  <%= form.select :product_id, Product.order(:name).pluck(:name, :id), { include_blank: "All products", selected: params[:product_id] },
    class: "select-field rounded-md border border-gray-300 px-3 py-2", onchange: "this.form.requestSubmit()" %>
  <%= form.submit "Search", class: "rounded-md bg-gray-900 px-3 py-2 text-white hover:bg-gray-800" %>
  <% if params[:q].present? || params[:product_id].present? %>
    <%= link_to "Clear", admin_customers_path, class: "px-3 py-2 text-gray-600 hover:text-gray-900" %>
  <% end %>
<% end %>

<% if @customers.any? %>
  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-2 font-medium">Email</th>
          <th class="px-4 py-2 font-medium">Name</th>
          <th class="px-4 py-2 font-medium">Licenses</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @customers.each do |customer| %>
          <tr class="transition-colors hover:bg-gray-50">
            <td class="px-4 py-2 font-medium">
              <%= link_to admin_customer_path(customer), class: "flex items-center gap-2 hover:text-gray-900" do %>
                <%= image_tag gravatar_url(customer.email), alt: "", width: 24, height: 24, loading: "lazy", class: "h-6 w-6 rounded-full bg-gray-100" %>
                <%= customer.email %>
              <% end %>
            </td>
            <td class="px-4 py-2 text-gray-600"><%= customer.name %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"><%= customer.licenses.count %></span>
            </td>
            <td class="px-4 py-2 text-right">
              <%= link_to "View", admin_customer_path(customer), class: "text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "admin/pagination" %>
<% elsif params[:q].present? || params[:product_id].present? %>
  <p class="text-gray-500">No customers found.</p>
<% else %>
  <p class="text-gray-500">No customers yet.</p>
<% end %>
