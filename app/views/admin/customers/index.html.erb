<% content_for :title, "Customers — Licencio" %>

<h1 class="mb-6 text-xl font-semibold tracking-tight">Customers</h1>

<%= form_with url: admin_customers_path, method: :get, class: "mb-5 flex flex-wrap items-center gap-3" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Search email, name…",
    class: "field-input min-w-64 flex-1" %>
  <%= form.select :product_id, Product.order(:name).pluck(:name, :id), { include_blank: "All products", selected: params[:product_id] },
    class: "field-select w-auto", onchange: "this.form.requestSubmit()" %>
  <%= form.submit "Search", class: "btn-primary" %>
  <% if params[:q].present? || params[:product_id].present? %>
    <%= link_to "Clear", admin_customers_path, class: "link-muted px-1" %>
  <% end %>
<% end %>

<% if @customers.any? %>
  <div class="table-card">
    <table class="data-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Name</th>
          <th>Licenses</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td class="font-medium">
              <%= link_to admin_customer_path(customer), class: "flex items-center gap-2.5 hover:text-gray-900" do %>
                <%= image_tag gravatar_url(customer.email), alt: "", width: 24, height: 24, loading: "lazy", class: "h-6 w-6 rounded-full bg-gray-100 ring-1 ring-gray-200" %>
                <span class="truncate"><%= customer.email %></span>
              <% end %>
            </td>
            <td class="text-gray-600"><%= customer.name %></td>
            <td>
              <span class="badge-gray tabular-nums"><%= customer.licenses.count %></span>
            </td>
            <td class="text-right">
              <%= link_to "View", admin_customer_path(customer), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "admin/pagination" %>
<% elsif params[:q].present? || params[:product_id].present? %>
  <p class="rounded-lg border border-dashed border-gray-200 bg-white px-4 py-10 text-center text-sm text-gray-500">No customers found.</p>
<% else %>
  <p class="rounded-lg border border-dashed border-gray-200 bg-white px-4 py-10 text-center text-sm text-gray-500">No customers yet.</p>
<% end %>
