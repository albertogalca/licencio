<% content_for :title, "#{@customer.email} — Licencio" %>

<div class="mb-8">
  <%= link_to "← Customers", admin_customers_path, class: "link-muted text-body" %>
  <div class="mt-2 flex items-center gap-3">
    <%= image_tag gravatar_url(@customer.email, size: 96), alt: "", width: 48, height: 48, class: "h-12 w-12 rounded-full bg-gray-100 ring-1 ring-gray-200" %>
    <div>
      <h1 class="text-title font-bold tracking-tight"><%= @customer.email %></h1>
      <% if @customer.name %><p class="text-body text-gray-500"><%= @customer.name %></p><% end %>
    </div>
  </div>
</div>

<h2 class="section-title mb-3">Licenses</h2>
<% if @licenses.any? %>
  <div class="space-y-4">
    <% @licenses.each do |license| %>
      <div class="card p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <p class="font-medium"><%= license.product.name %></p>
              <%= status_badge(license.status) %>
            </div>
            <p class="mt-1 truncate font-mono text-meta text-gray-500"><%= license.license_key %></p>
          </div>
          <%= link_to "Edit", edit_admin_license_path(license), class: "link-muted shrink-0 text-body" %>
        </div>
        <p class="mt-2 text-body text-gray-500">
          <span class="tabular-nums"><%= license.activations.active.size %>/<%= license.max_activations || "∞" %></span> seats
          <% if license.expires_at %>· expires <%= license.expires_at.to_date %><% end %>
        </p>
        <% if license.activations.any? %>
          <ul class="mt-3 space-y-1.5 border-t border-gray-100 pt-3 text-meta text-gray-600">
            <% license.activations.each do |a| %>
              <li class="flex items-center gap-2">
                <%= activation_dot(a) %>
                <span class="truncate <%= "text-gray-600 line-through" if a.deactivated_at %>"><%= a.device_name.presence || a.hardware_id %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="empty-state">No licenses.</p>
<% end %>
