<% content_for :title, "#{@customer.email} — Licencio" %>

<div class="mb-6">
  <%= link_to "← Customers", admin_customers_path, class: "text-sm text-gray-500" %>
  <div class="mt-1 flex items-center gap-3">
    <%= image_tag gravatar_url(@customer.email, size: 96), alt: "", width: 48, height: 48, class: "h-12 w-12 rounded-full bg-gray-100" %>
    <div>
      <h1 class="text-xl font-semibold"><%= @customer.email %></h1>
      <% if @customer.name %><p class="text-gray-600"><%= @customer.name %></p><% end %>
    </div>
  </div>
</div>

<h2 class="mb-3 text-sm font-semibold text-gray-500">Licenses</h2>
<% if @licenses.any? %>
  <div class="space-y-4">
    <% @licenses.each do |license| %>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2">
              <p class="font-medium"><%= license.product.name %></p>
              <%= status_badge(license.status) %>
            </div>
            <p class="mt-0.5 font-mono text-xs text-gray-500"><%= license.license_key %></p>
          </div>
          <%= link_to "Edit", edit_admin_license_path(license), class: "text-sm text-gray-600 hover:text-gray-900" %>
        </div>
        <p class="mt-1 text-xs text-gray-500">
          Seats <%= license.activations.active.size %>/<%= license.max_activations || "∞" %>
          <% if license.expires_at %>· expires <%= license.expires_at.to_date %><% end %>
        </p>
        <% if license.activations.any? %>
          <ul class="mt-3 space-y-1.5 border-t border-gray-100 pt-3 text-xs text-gray-600">
            <% license.activations.each do |a| %>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full <%= a.deactivated_at ? "bg-gray-300" : "bg-green-500" %>" title="<%= a.deactivated_at ? "deactivated" : "active" %>"></span>
                <span class="<%= "text-gray-400 line-through" if a.deactivated_at %>"><%= a.device_name.presence || a.hardware_id %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">No licenses.</p>
<% end %>
