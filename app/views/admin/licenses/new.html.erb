<% content_for :title, "New license — Licencio" %>

<h1 class="mb-6 text-title font-bold tracking-tight">New license</h1>

<div class="card max-w-xl p-6">
  <%= form_with model: @license, url: admin_licenses_path, method: :post, class: "space-y-4" do |form| %>
    <%= render "shared/form_errors", record: @license %>

    <div>
      <%= form.label :product_id, "Product", class: "field-label" %>
      <%= form.select :product_id, Product.order(:name).pluck(:name, :id), { include_blank: "Select a product" }, class: "field-select" %>
    </div>
    <div>
      <%= form.label :customer_email, "Customer email", class: "field-label" %>
      <%= form.email_field :customer_email, class: "field-input" %>
      <p class="field-hint">Optional — a customer is created if this email is new.</p>
    </div>
    <div>
      <%= form.label :max_activations, "Seats", class: "field-label" %>
      <%= form.number_field :max_activations, value: @license.max_activations || 3, class: "field-input" %>
    </div>
    <div>
      <%= form.label :status, class: "field-label" %>
      <%= form.select :status, License.statuses.keys, {}, class: "field-select" %>
    </div>
    <div>
      <%= form.label :expires_at, "Expires at", class: "field-label" %>
      <%= form.datetime_local_field :expires_at, class: "field-input" %>
      <p class="field-hint">Optional.</p>
    </div>
    <div>
      <%= form.label :update_policy, "Update policy", class: "field-label" %>
      <%= form.select :update_policy, License.update_policies.keys, { include_blank: "Inherit from product" }, class: "field-select" %>
    </div>
    <div>
      <%= form.label :licensed_version, "Version", class: "field-label" %>
      <%= form.number_field :licensed_version, class: "field-input" %>
      <p class="field-hint">For versioned policy — the max major version this license updates to.</p>
    </div>

    <div class="flex items-center gap-3 border-t border-gray-100 pt-4">
      <%= form.submit "Create license", class: "btn-primary" %>
      <%= link_to "Cancel", admin_licenses_path, class: "link-muted text-body" %>
    </div>
  <% end %>
</div>
