<% content_for :title, "Edit license — Licencio" %>

<h1 class="mb-1 text-title font-bold tracking-tight">Edit license</h1>
<p class="mb-6 font-mono text-meta text-gray-500"><%= @license.license_key %> · <%= @license.product.name %>
  <% if @license.customer %>· <%= @license.customer.email %><% end %></p>

<div class="max-w-xl space-y-6">
  <div class="card p-6">
    <%= form_with model: @license, url: admin_license_path(@license), method: :patch, class: "space-y-4" do |form| %>
      <%= render "shared/form_errors", record: @license %>

      <div>
        <%= form.label :status, class: "field-label" %>
        <%= form.select :status, License.statuses.keys, {}, class: "field-select" %>
      </div>
      <div>
        <%= form.label :max_activations, "Seats", class: "field-label" %>
        <%= form.number_field :max_activations, class: "field-input" %>
        <p class="field-hint">Devices that may run this license at once. Blank means unlimited.</p>
      </div>
      <div>
        <%= form.label :expires_at, "Expires at", class: "field-label" %>
        <%= form.datetime_local_field :expires_at, value: @license.expires_at&.strftime("%Y-%m-%dT%H:%M"), class: "field-input" %>
        <p class="field-hint">Optional.</p>
      </div>
      <div>
        <%= form.label :update_policy, "Update policy", class: "field-label" %>
        <%= form.select :update_policy, License.update_policies.keys, { include_blank: "Inherit from product" }, class: "field-select" %>
      </div>
      <div>
        <%= form.label :licensed_version, "Version", class: "field-label" %>
        <%= form.number_field :licensed_version, class: "field-input" %>
        <p class="field-hint">Bump to grant a v2+ upgrade.</p>
      </div>

      <div class="flex items-center gap-3 border-t border-gray-100 pt-4">
        <%= form.submit "Save changes", class: "btn-primary" %>
        <%= link_to "Cancel", admin_licenses_path, class: "link-muted text-body" %>
      </div>
    <% end %>
  </div>

  <div class="card p-6">
    <h2 class="section-title flex items-baseline gap-2">
      Devices
      <span class="font-normal text-gray-500">
        <%= @license.activations.active.size %> of <%= @license.max_activations || "∞" %> seats in use
      </span>
    </h2>
    <% activations = @license.activations.order(activated_at: :desc) %>
    <% if activations.any? %>
      <div class="mt-3 -mx-2 divide-y divide-gray-100">
        <% activations.each do |a| %>
          <div class="flex items-center gap-3 px-2 py-2.5 text-body">
            <%= activation_dot(a) %>
            <span class="flex-1 truncate <%= "text-gray-600" if a.deactivated_at %>"><%= a.device_name.presence || a.hardware_id %></span>
            <span class="shrink-0 text-meta text-gray-600 tabular-nums"><%= a.activated_at&.to_date %></span>
            <div class="w-24 shrink-0 text-right">
              <% if a.deactivated_at %>
                <span class="text-meta text-gray-600">deactivated</span>
              <% else %>
                <%= button_to "Deactivate", admin_activation_path(a), method: :delete,
                  form: { data: { turbo_confirm: "Deactivate this device? It frees a seat; the customer can reactivate." } },
                  class: "link-danger" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-body text-gray-500">No devices yet.</p>
    <% end %>
  </div>

  <% if @license.resendable_emails.any? %>
    <div class="card p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="section-title">Resend email</h2>
          <p class="field-hint">Re-send a lifecycle email to <%= @license.customer.email %>.</p>
        </div>
        <div class="flex flex-wrap justify-end gap-2">
          <% @license.resendable_emails.each do |kind| %>
            <%= button_to email_kind_label(kind), admin_license_emails_path(@license),
              params: { kind: kind },
              form: { data: { turbo_confirm: "Resend the #{email_kind_label(kind).downcase} email to #{@license.customer.email}?" } },
              class: "btn-ghost shrink-0" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% unless @license.refunded? %>
    <div class="card border-red-200 p-6">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="section-title">Revoke license</h2>
          <p class="field-hint">Sets the status to refunded and blocks activation.</p>
        </div>
        <%= button_to "Revoke license", admin_license_path(@license),
          method: :patch, params: { license: { status: "refunded" } },
          form: { data: { turbo_confirm: "Revoke this license? Its status becomes refunded." } },
          class: "btn-danger shrink-0" %>
      </div>
    </div>
  <% end %>
</div>
