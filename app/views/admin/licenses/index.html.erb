<% content_for :title, "Licenses — Licencio" %>

<div class="mb-6 flex items-center justify-between gap-4">
  <h1 class="text-xl font-semibold tracking-tight">Licenses</h1>
  <%= link_to "New license", new_admin_license_path, class: "btn-primary" %>
</div>

<%= form_with url: admin_licenses_path, method: :get, class: "mb-5 flex flex-wrap items-center gap-3" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Search key, customer, product…",
    class: "field-input min-w-64 flex-1" %>
  <%= form.select :product_id, Product.order(:name).pluck(:name, :id), { include_blank: "All products", selected: params[:product_id] },
    class: "field-select w-auto", onchange: "this.form.requestSubmit()" %>
  <%= form.select :status, License.statuses.keys, { include_blank: "All statuses", selected: params[:status] },
    class: "field-select w-auto", onchange: "this.form.requestSubmit()" %>
  <%= form.submit "Search", class: "btn-primary" %>
  <% if params[:q].present? || params[:product_id].present? || params[:status].present? %>
    <%= link_to "Clear", admin_licenses_path, class: "link-muted px-1" %>
  <% end %>
<% end %>

<% if @licenses.any? %>
  <div class="table-card">
    <table class="data-table">
      <thead>
        <tr>
          <th>Key</th>
          <th>Product</th>
          <th>Customer</th>
          <th>Status</th>
          <th>Seats</th>
          <th>Expires</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @licenses.each do |license| %>
          <tr>
            <td class="font-mono text-xs"><%= license.license_key %></td>
            <td class="text-gray-600"><%= license.product.name %></td>
            <td class="text-gray-600"><%= license.customer&.email %></td>
            <td><%= status_badge(license.status) %></td>
            <td class="text-gray-600 tabular-nums"><%= license.max_activations || "∞" %></td>
            <td class="text-gray-600 tabular-nums"><%= license.expires_at&.to_date %></td>
            <td class="text-right">
              <%= link_to "Edit", edit_admin_license_path(license), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "admin/pagination" %>
<% else %>
  <p class="rounded-lg border border-dashed border-gray-200 bg-white px-4 py-10 text-center text-sm text-gray-500">No licenses found.</p>
<% end %>
