<% content_for :title, "Renew your license — Licencio" %>

<%= render layout: "portal/key_form", locals: {
      url: portal_renewals_path,
      heading: "Renew your #{@product&.name || "license"}#{" license" if @product}",
      subheading: @license&.renewable? ?
        "Another year of updates. Your app keeps working either way. Only new versions stop." :
        "Enter the license key you'd like to renew.",
      submit_label: "Renew license" } do |form| %>
  <% if @license&.expires_at %>
    <p class="text-body text-gray-500">
      <% if @license.expires_at.past? %>
        Updates ended <span class="font-medium text-red-600"><%= @license.expires_at.to_date.to_fs(:long) %></span>
      <% else %>
        Updates run until <span class="font-medium text-gray-700"><%= @license.expires_at.to_date.to_fs(:long) %></span>
      <% end %>
    </p>
  <% elsif @license %>
    <p class="text-body text-gray-500">This license doesn't expire — there's nothing to renew.</p>
  <% elsif params[:license_key].present? %>
    <p class="text-body text-red-600">We couldn't find that license key.</p>
  <% end %>
<% end %>
