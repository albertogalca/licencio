<% content_for :title, "Your #{current_product.name} licenses — Licencio" %>

<header class="mb-8 flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold tracking-tight">Your <%= current_product.name %> licenses</h1>
  <%= button_to "Sign out", portal_session_path, method: :delete,
        class: "inline-flex shrink-0 items-center rounded-md border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900" %>
</header>

<% if @licenses.empty? %>
  <div class="rounded-lg border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
    <p class="text-sm text-gray-500">No <%= current_product.name %> licenses found for <span class="font-medium text-gray-700"><%= current_customer.email %></span>.</p>
  </div>
<% end %>

<div class="space-y-4">
  <% @licenses.each do |license| %>
    <% used = license.activations.active.size %>
    <% cap  = license.max_activations %>
    <article class="card p-5">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div data-controller="clipboard" class="relative min-w-0 flex-1">
          <input type="text" readonly value="<%= license.license_key %>"
                 data-clipboard-target="source" data-action="focus->clipboard#select"
                 class="field-input w-full pr-11 font-mono text-sm">
          <button type="button" data-action="clipboard#copy" aria-label="Copy license key"
                  class="absolute inset-y-0 right-0 flex cursor-pointer items-center rounded-r-md px-3 text-gray-400 transition-colors hover:text-gray-700">
            <svg data-clipboard-target="copyIcon" class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="7" y="7" width="9" height="9" rx="2" /><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
            </svg>
            <svg data-clipboard-target="checkIcon" class="hidden h-4 w-4 text-accent-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 10.5l3.5 3.5L15 6.5" />
            </svg>
          </button>
        </div>
        <%= status_badge(license.status) %>
      </div>

      <div class="mb-4">
        <p class="mb-1.5 text-xs text-gray-500">
          <span class="tabular-nums font-medium text-gray-700"><%= used %></span> of
          <span class="tabular-nums"><%= cap || "∞" %></span> seats in use
        </p>
        <% if cap %>
          <% pct = cap.zero? ? 0 : [(used.to_f / cap * 100).round, 100].min %>
          <% bar = used >= cap ? "bg-red-500" : (used >= cap * 0.8 ? "bg-amber-500" : "bg-accent-500") %>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-100">
            <div class="h-full rounded-full <%= bar %> transition-[width] duration-500 ease-out" style="width: <%= pct %>%"></div>
          </div>
        <% end %>
      </div>

      <% if license.effective_update_policy == "time_limited" && license.expires_at %>
        <p class="mb-4 text-xs text-gray-500">
          <% if license.expires_at.past? %>
            Expired <span class="font-medium text-red-600"><%= license.expires_at.to_date.to_fs(:long) %></span>
          <% else %>
            Expires <span class="font-medium text-gray-700"><%= license.expires_at.to_date.to_fs(:long) %></span>
          <% end %>
        </p>

        <% if license.renewable? %>
          <% variants = current_product.variants %>
          <% if variants.any? %>
            <%# Native submit (not Turbo): the controller redirects to Stripe (cross-origin), which Turbo can't follow. %>
            <%= form_with url: portal_renewals_path, method: :post, data: { turbo: false }, class: "mb-4 flex items-stretch gap-2" do %>
              <%= hidden_field_tag :license_id, license.id %>
              <% if variants.size > 1 %>
                <% default = (variants.find { |v| v.seats == license.max_activations } || variants.first).price_id %>
                <%= select_tag :price_id,
                      options_for_select(variants.map { |v| [ v.name.presence || v.price_id, v.price_id ] }, default),
                      class: "field-select text-sm" %>
              <% else %>
                <%= hidden_field_tag :price_id, variants.first.price_id %>
              <% end %>
              <%= submit_tag "Renew license",
                    class: "inline-flex shrink-0 cursor-pointer items-center rounded-md bg-accent-600 px-4 text-sm font-medium text-white transition-colors hover:bg-accent-700" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% active = license.activations.active %>
      <% if active.any? %>
        <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs font-medium uppercase tracking-wide text-gray-400">
              <th class="py-1.5">Device</th>
              <th class="py-1.5">Hardware ID</th>
              <th class="py-1.5">Activated</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% active.each do |activation| %>
              <tr class="border-t border-gray-100">
                <td class="py-2.5"><%= activation.device_name.presence || "—" %></td>
                <td class="py-2.5 font-mono text-xs text-gray-500"><%= activation.hardware_id %></td>
                <td class="py-2.5 text-gray-500 tabular-nums"><%= activation.activated_at.to_date.to_fs(:long) %></td>
                <td class="py-2.5 text-right">
                  <%= button_to "Deactivate", portal_activation_path(activation), method: :delete,
                        data: { turbo_confirm: "Free this seat? The device will need to reactivate." },
                        class: "cursor-pointer text-xs font-medium text-red-600 transition-colors hover:text-red-800" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% else %>
        <p class="border-t border-gray-100 pt-3 text-sm text-gray-400">No active devices.</p>
      <% end %>
    </article>
  <% end %>
</div>
