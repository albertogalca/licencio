<% content_for :title, "Your licenses — Licencio" %>

<header class="mb-10 flex items-baseline justify-between">
  <h1 class="text-2xl font-semibold">Your licenses</h1>
  <%= button_to "Sign out", portal_session_path, method: :delete,
        class: "text-sm text-gray-500 hover:text-gray-800" %>
</header>

<% if @licenses_by_product.empty? %>
  <p class="text-gray-500">No licenses found for <%= current_customer.email %>.</p>
<% end %>

<% @licenses_by_product.each do |product, licenses| %>
  <section class="mb-10">
    <h2 class="mb-4 text-lg font-medium"><%= product.name %></h2>

    <% licenses.each do |license| %>
      <article class="mb-4 rounded-lg border border-gray-200 bg-white p-5">
        <div class="mb-4 flex items-center justify-between gap-4">
          <code class="text-sm font-mono"><%= license.license_key %></code>
          <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs uppercase tracking-wide text-gray-600">
            <%= license.status %>
          </span>
        </div>

        <p class="mb-2 text-xs text-gray-500">
          <%= pluralize(license.activations.active.size, "device") %> of <%= license.max_activations %> seats in use
        </p>

        <% active = license.activations.active %>
        <% if active.any? %>
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-gray-400">
                <th class="py-1 font-medium">Device</th>
                <th class="py-1 font-medium">Hardware ID</th>
                <th class="py-1 font-medium">Activated</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% active.each do |activation| %>
                <tr class="border-t border-gray-100">
                  <td class="py-2"><%= activation.device_name.presence || "—" %></td>
                  <td class="py-2 font-mono text-xs text-gray-500"><%= activation.hardware_id %></td>
                  <td class="py-2 text-gray-500"><%= activation.activated_at.to_date.to_fs(:long) %></td>
                  <td class="py-2 text-right">
                    <%= button_to "Deactivate", portal_activation_path(activation), method: :delete,
                          data: { turbo_confirm: "Free this seat? The device will need to reactivate." },
                          class: "text-xs font-medium text-red-600 hover:text-red-800" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm text-gray-400">No active devices.</p>
        <% end %>
      </article>
    <% end %>
  </section>
<% end %>
