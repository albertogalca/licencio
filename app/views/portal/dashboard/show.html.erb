<% content_for :title, "Your #{current_product.name} licenses — Licencio" %>

<header class="mb-8 flex items-center justify-between gap-4">
  <h1 class="text-display text-balance font-bold tracking-tight">Your <%= current_product.name %> licenses</h1>
  <div class="flex shrink-0 items-center gap-2">
    <% if current_product.download_url.present? %>
      <%= link_to "Download app", current_product.download_url, class: "btn-primary" %>
    <% end %>
    <%= button_to "Sign out", portal_session_path, method: :delete, class: "btn-ghost" %>
  </div>
</header>

<% if @licenses.empty? %>
  <p class="empty-state">
    No <%= current_product.name %> licenses found for
    <span class="font-medium text-gray-700"><%= current_customer.email %></span>.
  </p>
<% end %>

<div class="space-y-4">
  <% @licenses.each do |license| %>
    <% used = license.activations.active.size %>
    <% cap  = license.max_activations %>
    <article class="card p-5">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div data-controller="clipboard" class="relative min-w-0 flex-1">
          <input type="text" readonly value="<%= license.license_key %>"
                 data-clipboard-target="source" data-action="focus->clipboard#select"
                 class="field-input w-full pr-11 font-mono text-body">
          <button type="button" data-action="clipboard#copy" aria-label="Copy license key"
                  class="absolute inset-y-0 right-0 flex cursor-pointer items-center rounded-r-md px-3 text-gray-600 transition-colors hover:text-gray-900">
            <svg data-clipboard-target="copyIcon" class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="7" y="7" width="9" height="9" rx="2" /><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
            </svg>
            <svg data-clipboard-target="checkIcon" class="hidden h-4 w-4 text-accent-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 10.5l3.5 3.5L15 6.5" />
            </svg>
          </button>
        </div>
        <%= status_badge(license.status) %>
      </div>

      <% full = cap && used >= cap %>
      <div class="mb-4">
        <p class="mb-2 text-body text-gray-600">
          <span class="tabular-nums font-medium <%= full ? "text-red-700" : "text-gray-900" %>"><%= used %></span> of
          <span class="tabular-nums"><%= cap || "∞" %></span> seats in use<%
          %><% if full %><span class="font-medium text-red-700"> · no seats left</span><% end %>
        </p>
        <% if cap %>
          <% pct = cap.zero? ? 0 : [(used.to_f / cap * 100).round, 100].min %>
          <% bar = full ? "bg-red-600" : (used >= cap * 0.8 ? "bg-amber-500" : "bg-accent-600") %>
          <%# A gauge, not a hairline: this is the one number a customer comes here to check. %>
          <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100 ring-1 ring-inset ring-gray-200"
               role="img" aria-label="<%= used %> of <%= cap %> seats in use">
            <div id="seatbar-<%= license.id %>" class="h-full rounded-full <%= bar %>"></div>
          </div>
          <%# ponytail: CSP style_src has no 'unsafe-inline', so a style="width:X%" attribute is dropped
              (nonces whitelist <style> elements, not style attributes) — emit a nonced <style> instead. %>
          <%= tag.style "#seatbar-#{license.id}{width:#{pct}%}", nonce: content_security_policy_nonce %>
        <% end %>
      </div>

      <% if license.effective_update_policy == "time_limited" && license.expires_at %>
        <p class="mb-4 text-body text-gray-500">
          <% if license.expires_at.past? %>
            Expired <span class="font-medium text-red-600"><%= license.expires_at.to_date.to_fs(:long) %></span>
          <% else %>
            Expires <span class="font-medium text-gray-700"><%= license.expires_at.to_date.to_fs(:long) %></span>
          <% end %>
        </p>

        <% if license.renewable? && current_product.variants.any? %>
          <%# Native submit (not Turbo): the controller redirects to Stripe (cross-origin), which Turbo can't follow. %>
          <%# Price is chosen server-side from the license's own tier — not submitted by the client. %>
          <%= form_with url: portal_renewals_path, method: :post, class: "mb-4",
                  data: { turbo: false, controller: "submit-lock", action: "submit->submit-lock#lock" } do %>
            <%= hidden_field_tag :license_key, license.license_key %>
            <%= submit_tag "Renew license", class: "btn-primary",
                    data: { "submit-lock-target": "button", locked_label: "Taking you to checkout…" } %>
          <% end %>
        <% end %>
      <% end %>

      <% if license.upgradeable? %>
        <p class="mb-4">
          <%= link_to "Add more seats", new_portal_upgrade_path(license_key: license.license_key),
                class: "link-accent tap-target text-body" %>
        </p>
      <% end %>

      <% active = license.activations.active %>
      <% if active.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-body">
            <thead>
              <tr class="text-left text-meta font-semibold uppercase tracking-caps text-gray-600">
                <th class="py-1.5">Device</th>
                <th class="py-1.5">Hardware ID</th>
                <th class="py-1.5">Activated</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% active.each do |activation| %>
                <tr class="border-t border-gray-100">
                  <td class="py-2.5"><%= activation.device_name.presence || "—" %></td>
                  <td class="max-w-[12rem] break-all py-2.5 font-mono text-meta text-gray-500"><%= activation.hardware_id %></td>
                  <td class="py-2.5 text-gray-500 tabular-nums"><%= activation.activated_at.to_date.to_fs(:long) %></td>
                  <td class="py-2.5 text-right">
                    <%= button_to "Deactivate", portal_activation_path(activation), method: :delete,
                          data: { turbo_confirm: "Free this seat? The device will need to reactivate." },
                          class: "link-danger" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="border-t border-gray-100 pt-3 text-body text-gray-600">No active devices.</p>
      <% end %>
    </article>
  <% end %>
</div>
