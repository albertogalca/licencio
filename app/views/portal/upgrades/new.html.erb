<% content_for :title, "Add more seats — #{@product&.name || "Licencio"}" %>

<%= render layout: "portal/key_form", locals: {
      url: portal_upgrades_path,
      heading: "Add more seats#{" to your #{@product.name} license" if @product}",
      subheading: @options.any? ?
        "Same license key, more devices. You only pay the difference." :
        "Enter the license key you'd like to upgrade.",
      submit_label: @options.any? ? "Add seats" : "See upgrade options" } do |form| %>
  <%# Keeps the page branded when create bounces back with an error. %>
  <%= hidden_field_tag :product, params[:product], id: nil if params[:product].present? %>

  <%# First submit shows the options; only a visible, picked option goes to Stripe. %>
  <% if @options.any? %>
    <fieldset class="space-y-2">
      <legend class="field-label">Upgrade to</legend>
      <% @options.each_with_index do |option, i| %>
        <label class="flex cursor-pointer items-center justify-between rounded-md border border-gray-200 px-3 py-2 text-body has-[:checked]:border-accent-600 has-[:checked]:ring-1 has-[:checked]:ring-accent-600">
          <span class="flex items-center gap-2">
            <%= radio_button_tag :price_id, option.price_id, i.zero? %>
            <%= option.seats %> devices <span class="text-gray-500">(+<%= option.seats - @license.max_activations %>)</span>
          </span>
          <span class="font-medium text-gray-700"><%= money_cents(option.amount_cents, option.currency) %></span>
        </label>
      <% end %>
    </fieldset>
  <%# An active license with no options is usually fine, not stuck. Say which it is, so
      nobody is sent to email support over a license that is already as large as it gets. %>
  <% elsif @license&.unlimited_seats? %>
    <p class="text-body text-gray-500">This license already covers unlimited devices, so there's nothing to add.</p>
  <% elsif @license&.top_tier? %>
    <p class="text-body text-gray-500">
      This license is already the largest size, covering <%= pluralize(@license.max_activations, "device") %>.
    </p>
  <% elsif @license %>
    <p class="text-body text-gray-500">
      There's no self-serve upgrade for this license — email support and we'll sort it out.
    </p>
  <% elsif params[:license_key].present? %>
    <p class="text-body text-red-600">We couldn't find that license key.</p>
  <% end %>
<% end %>
