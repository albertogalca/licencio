<% content_for :title, "Affiliate dashboard — Licencio" %>

<header class="mb-8 flex items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Hi <%= @affiliate.name %></h1>
    <p class="mt-1 text-sm text-gray-500">
      Your code <span class="font-mono font-medium text-gray-700"><%= @affiliate.code %></span> ·
      <span class="tabular-nums"><%= @affiliate.commission_percent %></span>% commission
    </p>
  </div>
  <%= button_to "Sign out", affiliate_session_path, method: :delete,
        class: "inline-flex shrink-0 items-center rounded-md border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900" %>
</header>

<div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% [
       ["Sales", @sales_count],
       ["Revenue referred", money_cents(@revenue_cents)],
       ["Available to pay out", money_cents(@owed_cents)],
       ["Pending (in hold)", money_cents(@pending_cents)],
     ].each do |label, value| %>
    <div class="card p-4">
      <p class="text-xs text-gray-500"><%= label %></p>
      <p class="mt-1 text-lg font-semibold tabular-nums"><%= value %></p>
    </div>
  <% end %>
</div>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Your referral link<%= "s" if @products.many? %></h2>
<% if @products.any? %>
  <div class="mb-4 space-y-3">
    <% @products.each do |product| %>
      <% url = @affiliate.referral_url(product) %>
      <div>
        <p class="field-label"><%= product.name %></p>
        <div data-controller="clipboard" class="relative">
          <input type="text" readonly value="<%= url %>"
                 data-clipboard-target="source" data-action="focus->clipboard#select"
                 class="field-input w-full pr-11 font-mono text-xs">
          <button type="button" data-action="clipboard#copy" aria-label="Copy link"
                  class="absolute inset-y-0 right-0 flex cursor-pointer items-center rounded-r-md px-3 text-gray-400 transition-colors hover:text-gray-700">
          <svg data-clipboard-target="copyIcon" class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="7" y="7" width="9" height="9" rx="2" /><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
          </svg>
          <svg data-clipboard-target="checkIcon" class="hidden h-4 w-4 text-accent-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 10.5l3.5 3.5L15 6.5" />
          </svg>
          </button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
<p class="mb-8 text-xs text-gray-400">
  Tip: you can add <code>?ref=<%= @affiliate.code %></code> to any page on our site — the referral is tracked for 60 days.
</p>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Payouts</h2>
<% if @payouts.any? %>
  <div class="table-card">
    <table class="data-table">
      <thead>
        <tr><th>Paid</th><th>Amount</th><th>Note</th></tr>
      </thead>
      <tbody>
        <% @payouts.each do |payout| %>
          <tr>
            <td><%= payout.paid_at.to_date %></td>
            <td class="tabular-nums"><%= money_cents(payout.amount_cents, payout.currency) %></td>
            <td class="text-gray-500"><%= payout.note %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-lg border border-dashed border-gray-200 bg-white px-4 py-8 text-center text-sm text-gray-500">
    Total paid so far: <span class="font-medium tabular-nums"><%= money_cents(@paid_cents) %></span>. No payouts recorded yet.
  </p>
<% end %>
