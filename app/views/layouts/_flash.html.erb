<% if notice || alert %>
  <div class="pointer-events-none fixed bottom-4 right-4 z-50 flex w-full max-w-sm flex-col gap-2">
    <% if notice %>
      <div data-controller="flash" class="toast border-accent-500 bg-accent-50 text-accent-800">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd" />
        </svg>
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div data-controller="flash" class="toast border-red-500 bg-red-50 text-red-800">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM9 6a1 1 0 1 1 2 0v5a1 1 0 1 1-2 0V6Zm1 9.5a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Z" clip-rule="evenodd" />
        </svg>
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
