<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin — Licencio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <% if current_admin %>
      <header class="border-b border-gray-200 bg-white">
        <nav class="mx-auto flex max-w-5xl items-center gap-6 px-5 py-3 text-sm">
          <%= link_to "Licencio", admin_root_path, class: "font-semibold" %>
          <%= link_to "Products", admin_products_path, class: "text-gray-600 hover:text-gray-900" %>
          <%= link_to "Licenses", admin_licenses_path, class: "text-gray-600 hover:text-gray-900" %>
          <%= link_to "Customers", admin_customers_path, class: "text-gray-600 hover:text-gray-900" %>
          <%= link_to "Activations", admin_activations_path, class: "text-gray-600 hover:text-gray-900" %>
          <span class="ml-auto text-gray-400"><%= current_admin.email %></span>
          <%= button_to "Sign out", admin_session_path, method: :delete, class: "text-gray-600 hover:text-gray-900" %>
        </nav>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl px-5 py-10">
      <% if notice %>
        <p class="mb-6 rounded-md bg-green-50 px-4 py-3 text-sm text-green-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
