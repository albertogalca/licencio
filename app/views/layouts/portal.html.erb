<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Your licenses — Licencio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900 antialiased">
    <main class="mx-auto flex w-full max-w-3xl grow flex-col px-5 py-12 <%= "items-center justify-center gap-6" if content_for?(:centered) %>">
      <%= render "layouts/flash" %>
      <%= yield %>
      <p class="flex items-center gap-1.5 self-center text-xs text-gray-400 <%= "mt-auto pt-10" unless content_for?(:centered) %>">
        <%= image_tag "/icon.svg", alt: "", class: "h-4 w-4", aria: { hidden: true } %>
        Powered by Licencio
      </p>
    </main>
  </body>
</html>
